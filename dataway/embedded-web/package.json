{
  "name": "dataway-embedded-web",
  "version": "4.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "check": "npm run lint && npm test",
    "dev": "vite --host 127.0.0.1 --mode proxy",
    "dev:proxy": "vite --host 127.0.0.1 --mode proxy",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
