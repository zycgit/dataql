    "test": "node --test test/*.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "element-plus": "2.14.6",
    "monaco-editor": "0.56.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "vite": "8.3.0"
  }
}
