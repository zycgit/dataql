<config xmlns="https://www.hasor.net/sechma/main">
    <hasor.boot.web.connectors.http.host>127.0.0.1</hasor.boot.web.connectors.http.host>
    <hasor.boot.web.connectors.http.port>8080</hasor.boot.web.connectors.http.port>
    <hasor.boot.web.server.contextPath>/</hasor.boot.web.server.contextPath>

    <dataway>
        <api-enabled>true</api-enabled>
        <api-prefix>/api</api-prefix>
        <admin-enabled>true</admin-enabled>
        <admin-prefix>/admin/api</admin-prefix>
        <admin-ui>/admin</admin-ui>
        <docs-enabled>true</docs-enabled>
        <docs-prefix>/docs</docs-prefix>
    </dataway>

    <example>
        <!-- Change to nacos to store API metadata in the configured Nacos instance. -->
        <metadata>jdbc</metadata>
        <nacos>
            <server-addr>127.0.0.1:8848</server-addr>
            <namespace></namespace>
            <username></username>
            <password></password>
            <group>DATAWAY_EXAMPLE</group>
            <data-id>dataway-hasor-example</data-id>
        </nacos>
        <upload>
            <directory>./target/uploads</directory>
            <memory-threshold>65536</memory-threshold>
        </upload>
        <jwt>
            <!-- Empty creates a random signing key for this application instance. -->
            <secret></secret>
            <expiration-seconds>900</expiration-seconds>
        </jwt>
        <database>
            <main>
                <url>jdbc:h2:mem:dataway-example-main</url>
                <username>sa</username>
                <password></password>
            </main>
            <ds1>
                <url>jdbc:h2:mem:dataway-example-ds1</url>
                <username>sa</username>
                <password></password>
            </ds1>
            <ds2>
                <url>jdbc:h2:mem:dataway-example-ds2</url>
                <username>sa</username>
                <password></password>
            </ds2>
        </database>
    </example>
</config>
