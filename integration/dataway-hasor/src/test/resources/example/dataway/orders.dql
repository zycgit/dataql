hint FRAGMENT_SQL_DATA_SOURCE = "ds2"
hint FRAGMENT_SQL_OPEN_PACKAGE = "off"

var orders = @@selectSql(id)<%
    SELECT id AS "id", person_id AS "personId", product AS "product", amount AS "amount"
    FROM example_orders
    WHERE person_id = #{id}
    ORDER BY id
%>;
return orders(${id});
